# ---- Server ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/throttlebox
REDIS_URL=redis://localhost:6379
SESSION_SECRET=dev-only-change-me

# Pepper for API key hashing. Generate with: openssl rand -hex 32
KEY_PEPPER=change-me-to-a-long-random-value
COOKIE_DOMAIN=localhost
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001

# Number of reverse proxies in front of the app. 0 means the app is reached
# directly, so X-Forwarded-For is ignored. Set to 1 behind a single proxy.
TRUST_PROXY_HOPS=0

# Brute-force protection for the credential endpoints, per IP.
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
# ---- Web ----
NEXT_PUBLIC_API_URL=http://localhost:3001
