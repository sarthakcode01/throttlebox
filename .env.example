# ---- Server ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/throttlebox
REDIS_URL=redis://localhost:6379
SESSION_SECRET=dev-only-change-me

# Pepper for API key hashing. Generate with: openssl rand -hex 32
KEY_PEPPER=change-me-to-a-long-random-value
COOKIE_DOMAIN=localhost
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001

# IPs or CIDR ranges of the reverse proxies in front of the app, comma
# separated. Empty means the app is reached directly, so X-Forwarded-For is
# ignored — which is what you want unless you really do run a proxy.
# TRUST_PROXY_CIDRS=10.0.0.0/8,172.16.0.1

# Ceiling on the session-authenticated dashboard API, per user per window.
API_RATE_LIMIT_MAX=600
API_RATE_LIMIT_WINDOW_SECONDS=60

# Brute-force protection for the credential endpoints, per IP.
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
# ---- Web ----
NEXT_PUBLIC_API_URL=http://localhost:3001
